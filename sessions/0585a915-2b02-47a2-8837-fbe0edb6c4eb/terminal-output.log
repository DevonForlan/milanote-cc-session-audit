// Local-only logging hook. NO network, NO git. Always exits 0 so it can never block Claude Code.
// Registered for: UserPromptSubmit, PostToolUse, PostToolUseFailure, Stop, SessionEnd.
// Appends raw events to export/spool/<session>.jsonl (gitignored) and, on Stop/SessionEnd,
// re-runs export.js against transcript_path to refresh export/raw and export/review.
const fs = require("fs"), path = require("path"), cp = require("child_process");
try {
  const input = JSON.parse(fs.readFileSync(0, "utf8") || "{}");
  const root = path.resolve(__dirname, "..");
  const spool = path.join(root, "spool"); fs.mkdirSync(spool, { recursive: true });
  const ev = input.hook_event_name;
  const pick = {
    UserPromptSubmit: ["prompt"],
    PostToolUse: ["tool_name", "tool_input", "tool_response", "tool_use_id", "duration_ms"],
    PostToolUseFailure: ["tool_name", "tool_input", "tool_use_id", "error", "is_interrupt"],
    Stop: ["last_assistant_message"],
    SessionEnd: ["reason"],
  }[ev] || [];
  const rec = { ts: new Date().toISOString(), event: ev, session_id: input.session_id };
  for (const k of pick) if (k in input) rec[k] = input[k];
  fs.appendFileSync(path.join(spool, `${input.session_id || "unknown"}.jsonl`), JSON.stringify(rec) + "\n");
  if ((ev === "Stop" || ev === "SessionEnd") && input.transcript_path && fs.existsSync(input.transcript_path))
    cp.spawnSync(process.execPath, [path.join(__dirname, "export.js"), input.transcript_path, root], { timeout: 20000 });
} catch (e) {
  try { fs.appendFileSync(path.join(__dirname, "..", "spool", "hook-errors.log"), `${new Date().toISOString()} ${e.message}\n`); } catch {}
}
process.exit(0);
EOF
printf 'raw/\nspool/\n*.jsonl\n*.env\n*cookie*\n*token*\n*profile*\n' > .gitignore; cp .gitignore review/.gitignore
# simulated test (fake session id so real data is not touched)
echo '{"hook_event_name":"UserPromptSubmit","session_id":"TEST-0000","prompt":"hello"}' | node tools/hook-log.js; echo "exit=$?"
echo '{"hook_event_name":"PostToolUse","session_id":"TEST-0000","tool_name":"Bash","tool_input":{"command":"ls"},"tool_response":{"stdout":"a","stderr":""}}' | node tools/hook-log.js
echo '{"hook_event_name":"PostToolUseFailure","session_id":"TEST-0000","tool_name":"Bash","error":"Exit code 1\nboom"}' | node tools/hook-log.js
echo 'not json' | node tools/hook-log.js; echo "exit(bad input)=$?"
echo '{"hook_event_name":"Stop","session_id":"TEST-0000","last_assistant_message":"done"}' | node tools/hook-log.js
cat spool/TEST-0000.jsonl; ls spool; rm -f spool/TEST-0000.jsonl
echo "--- real export rerun"; node tools/export.js
