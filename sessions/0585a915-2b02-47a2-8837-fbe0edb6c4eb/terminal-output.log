// Human-gated GitHub sync for export/review (the ONLY tree that is ever pushed).
//   node tools/sync.js                          -> DRY RUN: scan + show what would be committed. No network.
//   node tools/sync.js --approved-by-human      -> scan, verify repo is PRIVATE, commit, push, verify remote SHA.
// Authorization on record: IT department verbal consent only (no written record). ChatGPT access NOT authorized.
const fs = require("fs"), path = require("path"), cp = require("child_process");
const root = path.resolve(__dirname, ".."), rev = path.join(root, "review");
const SLUG = "DevonForlan/milanote-cc-session-audit";
const approved = process.argv.includes("--approved-by-human");
const run = (c, a, o = {}) => cp.spawnSync(c, a, { cwd: rev, encoding: "utf8", ...o });
const fail = m => { console.error("ABORT: " + m); process.exit(1); };

// refresh derived data (local only)
cp.spawnSync(process.execPath, [path.join(__dirname, "export.js")], { encoding: "utf8" });
cp.spawnSync(process.execPath, [path.join(__dirname, "update-reports.js")], { encoding: "utf8" });

// secret / leak scan over everything that would be uploaded (defence in depth; NOT a substitute for human review)
const BAD = [/gh[pousr]_[A-Za-z0-9]{20,}/, /github_pat_[A-Za-z0-9_]{20,}/, /sk-[A-Za-z0-9_-]{20,}/, /-----BEGIN [A-Z ]*PRIVATE KEY-----/,
  /AKIA[0-9A-Z]{16}/, /eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}/, /[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/,
  /devon[.-]tseng/i, /[REDACTED:windows-username]/i];
const walk = d => fs.readdirSync(d, { withFileTypes: true }).flatMap(e => e.name === ".git" ? [] : e.isDirectory() ? walk(path.join(d, e.name)) : [path.join(d, e.name)]);
let hits = 0;
for (const f of walk(rev)) { const t = fs.readFileSync(f, "utf8"); for (const re of BAD) { const m = t.match(re); if (m) { hits++; console.error(`LEAK? ${path.relative(rev, f)} ~ ${re} -> ${m[0].slice(0, 30)}`); } } }
if (hits) fail(`${hits} possible leak(s) in files to upload. Fix redaction rules, re-export, retry.`);
console.log("scan: clean");

const st = run("git", ["status", "--short"]).stdout; console.log("pending changes:\n" + (st || "(none)"));
if (!approved) { console.log("\nDRY RUN only. Re-run with --approved-by-human after you reviewed export/review/."); process.exit(0); }

const vis = cp.spawnSync("gh", ["repo", "view", SLUG, "--json", "isPrivate", "--jq", ".isPrivate"], { encoding: "utf8" }).stdout.trim();
if (vis !== "true") fail(`repo ${SLUG} is not confirmed Private (got "${vis}")`);
run("git", ["add", "-A"]);
const msg = `Sync session records (human-approved ${new Date().toISOString()})\n\nAuthorization: IT verbal consent only, no written record. ChatGPT access not authorized.\n\nCo-Authored-By: Claude Sonnet 5.5 <[REDACTED:email]>`;
const c = run("git", ["commit", "-m", msg]); console.log(c.stdout.split("\n")[0] || c.stderr.split("\n")[0]);
const p = run("git", ["push", "-u", "origin", "main"]); if (p.status) fail("push failed: " + p.stderr);
const local = run("git", ["rev-parse", "HEAD"]).stdout.trim();
const remote = run("git", ["ls-remote", "origin", "refs/heads/main"]).stdout.split(/\s/)[0];
if (local !== remote) fail(`SHA mismatch local=${local} remote=${remote}`);
fs.appendFileSync(path.join(rev, "logs", "execution-history.md"), `- ${new Date().toISOString()} PUSHED (human-approved) commit ${local} to ${SLUG}\n`);
console.log(`SYNC OK  commit ${local}  https://github.com/${SLUG}/commit/${local}`);
EOF
echo "--- dry run"; node tools/sync.js 2>&1 | head -30
