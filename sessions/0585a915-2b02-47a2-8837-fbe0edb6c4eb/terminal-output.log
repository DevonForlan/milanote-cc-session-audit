// Derives reports from the ALREADY-REDACTED review/ tree. Local only. No network/git.
// - rewrites review/reports/sessions-index.md (derived; every session ever exported stays listed)
// - replaces the AUTO block in review/reports/latest.md
// - appends (never rewrites) one line to review/logs/execution-history.md when a session's counts changed
const fs = require("fs"), path = require("path");
const rev = path.resolve(__dirname, "..", "review");
const sdir = path.join(rev, "sessions");
if (!fs.existsSync(sdir)) process.exit(0);
const rows = [];
for (const id of fs.readdirSync(sdir)) {
  const d = path.join(sdir, id);
  try {
    const m = JSON.parse(fs.readFileSync(path.join(d, "session-metadata.json"), "utf8"));
    const conv = fs.readFileSync(path.join(d, "conversation.md"), "utf8");
    const parts = conv.split(/\n## \[/).slice(1).map(p => { const i = p.indexOf("\n"); return { head: p.slice(0, i), body: p.slice(i + 1).trim() }; });
    const last = role => [...parts].reverse().find(p => p.head.includes("] " + role));
    const cut = (p, n) => p ? p.body.replace(/\s+/g, " ").slice(0, n) + (p.body.length > n ? "…" : "") : "(none)";
    rows.push({ id, m, lu: last("USER"), la: last("ASSISTANT"), cut });
  } catch (e) { rows.push({ id, err: e.message }); }
}
rows.sort((a, b) => (b.m?.lastTimestamp || "").localeCompare(a.m?.lastTimestamp || ""));
let idx = "# Sessions index (auto-generated from redacted review/ files)\n\nRegenerated on every Stop/SessionEnd. Sessions are never removed from this list.\n\n| Session | First | Last | Conv | Tool entries | Shell cmds |\n|---|---|---|---|---|---|\n";
for (const r of rows) idx += r.err ? `| ${r.id} | error: ${r.err} |||||\n` :
  `| ${r.id} | ${r.m.firstTimestamp} | ${r.m.lastTimestamp} | ${r.m.counts.conversationEntries} | ${r.m.counts.toolEntries} | ${r.m.counts.shellCommands} |\n`;
fs.mkdirSync(path.join(rev, "reports"), { recursive: true });
fs.writeFileSync(path.join(rev, "reports", "sessions-index.md"), idx);
const top = rows.find(r => !r.err);
let auto = `<!-- AUTO:START -->\n## Auto status (generated ${new Date().toISOString()})\n- Sessions exported: ${rows.length} (see sessions-index.md)\n`;
if (top) auto += `- Most recent session: ${top.id}, last activity ${top.m.lastTimestamp}\n- Last user prompt (excerpt): ${top.cut(top.lu, 400)}\n- Last assistant reply (excerpt): ${top.cut(top.la, 600)}\n- Full text: sessions/${top.id}/conversation.md, tool-calls.md, terminal-output.log\n`;
auto += `- Upload status: NOT PUSHED unless a human-approved sync has been recorded in logs/execution-history.md\n<!-- AUTO:END -->`;
const lp = path.join(rev, "reports", "latest.md");
let lt = fs.existsSync(lp) ? fs.readFileSync(lp, "utf8") : "# Latest report\n";
lt = /<!-- AUTO:START -->[\s\S]*<!-- AUTO:END -->/.test(lt) ? lt.replace(/<!-- AUTO:START -->[\s\S]*<!-- AUTO:END -->/, () => auto) : lt.trimEnd() + "\n\n" + auto + "\n";
fs.writeFileSync(lp, lt);
const hp = path.join(rev, "logs", "execution-history.md"); fs.mkdirSync(path.dirname(hp), { recursive: true });
const hist = fs.existsSync(hp) ? fs.readFileSync(hp, "utf8") : "# Execution history (append only)\n";
for (const r of rows) if (!r.err) {
  const line = `- ${new Date().toISOString()} auto-export ${r.id}: conv=${r.m.counts.conversationEntries} tools=${r.m.counts.toolEntries} shell=${r.m.counts.shellCommands} (last activity ${r.m.lastTimestamp})`;
  const key = `auto-export ${r.id}: conv=${r.m.counts.conversationEntries} tools=${r.m.counts.toolEntries} shell=${r.m.counts.shellCommands} `;
  if (!hist.includes(key)) fs.appendFileSync(hp, (hist.endsWith("\n") ? "" : "\n") + line + "\n");
}
EOF
